{
  "name": "aphw-ddi-police-force",
  "version": "0.1.0",
  "description": "Microservice to lookup police force covering specified coordinates",
  "homepage": "https://github.com/DEFRA/aphw-ddi-police-force",
  "main": "app/index.js",
  "scripts": {
    "pretest": "npm run test:lint",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathPatterns=test/unit --coverage=false",
    "test:watch": "jest --coverage=false --onlyChanged --watch --runInBand",
    "test:lint": "standard",
    "test:debug": "node --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "start:watch": "nodemon --inspect=0.0.0.0 --ext js --legacy-watch app/index.js",
    "start:debug": "nodemon --inspect-brk=0.0.0.0 --ext js --legacy-watch app/index.js"
  },
  "author": "Defra",
  "contributors": [],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.17.0",
    "@hapi/hapi": "^21.4.10",
    "@hapi/wreck": "^18.1.0",
    "@mapbox/togeojson": "^0.16.2",
    "@xmldom/xmldom": "^0.8.10",
    "applicationinsights": "^3.16.0",
    "boost-geospatial-index": "^1.5.0",
    "joi": "^17.13.8",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.0.1",
    "standard": "^17.1.2"
  },
  "standard": {
    "globals": [
      "describe",
      "beforeEach",
      "expect",
      "test",
      "afterEach",
      "jest",
      "beforeAll",
      "afterAll"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "**/test-output/**"
    ]
  },
  "allowScripts": {
    "boost-geospatial-index@1.5.0": true
  },
  "overrides": {
    "uuid": "$uuid",
    "glob@^10": "^14.0.3",
    "glob@^13": "^14.0.3",
    "minimatch@^10": "^11.0.4"
  }
}